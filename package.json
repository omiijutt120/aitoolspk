{
  "name": "aitoolspk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "predev": "node scripts/optimize-assets.mjs",
    "catalog:import": "node scripts/import-catalog.mjs",
    "prebuild": "node scripts/import-catalog.mjs --if-present && node scripts/optimize-assets.mjs && node scripts/validate-public.mjs",
    "build": "next build --webpack",
    "postbuild": "node scripts/fix-static-paths.mjs",
    "start": "serve out -l 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write src scripts tests *.ts *.mjs README.md"
  },
  "dependencies": {
    "fuse.js": "^7.1.0",
    "geist": "^1.8.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "csv-parse": "^6.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
